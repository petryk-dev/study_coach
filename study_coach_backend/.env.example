PORT=3006
GROQ_API_KEY=
DATABASE_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Mailtrap
MAILTRAP_API_KEY=
MAILTRAP_INBOX_ID=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Study Coach

# Set to 1 when running behind a proxy/load balancer
TRUST_PROXY=

# Timezone that defines "today" for card due dates
APP_TIMEZONE=Europe/Prague

# Expo push notifications (optional: only if push security is enabled in your Expo project)
EXPO_ACCESS_TOKEN=
# Set to false to turn off the 07:00 daily plan job (e.g. when running several servers)
ENABLE_DAILY_JOB=true
